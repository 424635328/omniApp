{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch --show-current*)",
      "Bash(java -version*)",
      "Bash(./gradlew tasks*)",
      "Bash(./gradlew :app:compileDebugKotlin*)",
      "Bash(./gradlew :shared:compileDebugKotlinAndroid*)",
      "Bash(./gradlew :shared:desktopTest*)",
      "Bash(./gradlew :app:testDebugUnitTest*)",
      "Bash(./gradlew :app:assembleDebug*)"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git pull*)",
      "Bash(git merge*)",
      "Bash(git reset*)",
      "Bash(git restore*)",
      "Bash(git stash*)",
      "Bash(git cherry-pick*)",
      "Bash(rm *)"
    ]
  }
}
